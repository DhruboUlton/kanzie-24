generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id               String        @id @default(cuid())
  email            String        @unique
  passwordHash     String
  name             String
  // Nullable so the column could be added to an existing table without a
  // default. A user with no role has no permissions and is refused at
  // login — roles are assigned explicitly, never inferred.
  roleId           String?
  role             Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  isActive         Boolean       @default(true)
  lastLoginAt      DateTime?
  // Sessions issued before this instant are rejected by getAdminContext.
  // Stamped on password change/reset so a leaked or stale 7-day JWT stops
  // working the moment the password moves. Null means no boundary yet, so
  // existing tokens keep working until the next password change.
  sessionValidFrom DateTime?
  activityLogs     ActivityLog[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([roleId])
}

// Roles are data so they can be created and edited in the admin; the
// permission keys they hold are validated against the code catalogue in
// src/lib/permissions.ts on every write. Storing them as a JSON array
// rather than a join table keeps this to one extra table — see that file
// for the reasoning.
model Role {
  id          String      @id @default(cuid())
  key         String      @unique
  name        String
  description String?     @db.Text
  // System roles ship with the app and cannot be deleted or re-keyed.
  isSystem    Boolean     @default(false)
  permissions Json
  users       AdminUser[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

// Append-only from the application's point of view: nothing in the app
// updates or deletes a row here. Actor identity is denormalised so the
// trail survives the staff account being deleted.
model ActivityLog {
  id          String     @id @default(cuid())
  actorId     String?
  actor       AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail  String
  actorName   String
  action      String
  entityType  String?
  entityId    String?
  description String?    @db.Text
  metadata    Json?
  createdAt   DateTime   @default(now())

  @@index([createdAt])
  @@index([actorId])
  @@index([entityType, entityId])
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  // Cover art for the "Shop by machine" tiles. Null falls back to the
  // first product filed under the category, which is what every tile used
  // to show whether it suited the category or not.
  imageUrl  String?    @db.Text
  // Whether the homepage gives this category its own product rail. Nothing
  // else reads it: the category keeps its "Shop by machine" tile, its page,
  // its nav link and its place in the shop filter — this decides only which
  // categories get a preview row of products on the front page.
  // Defaults true so every category that predates the flag keeps its rail.
  showOnHomepage Boolean @default(true)
  // Self-relation, one level deep: a category with a parent is a
  // subcategory and cannot itself have children (enforced in
  // src/lib/actions/category.ts). Parents act as groupings — products are
  // assigned to leaf categories.
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id                  String          @id @default(cuid())
  slug                String          @unique
  name                String
  brand               String
  sku                 String          @unique
  categoryId          String
  category            Category        @relation(fields: [categoryId], references: [id])
  // The list price, and the single source of truth for what the product is
  // worth before any discount. Never rewritten by a sale.
  priceCents          Int
  // A percentage sale off priceCents. Null means no sale is running — the
  // "On sale" toggle in the admin is exactly this field being set or cleared,
  // so there is no separate boolean to fall out of step with it.
  salePercent         Int?
  // A manually typed original price, for a product that was always sold at a
  // markdown rather than being put on a percentage sale. Ignored while
  // salePercent is set: see resolvePricing() for the precedence.
  compareAtPriceCents Int?
  scale               String
  shortDescription    String          @db.Text
  description         String          @db.Text
  features            Json // Array of strings: ["feature 1", "feature 2"]
  specs               Json // Array of objects: [{"label": "Scale", "value": "1:14"}]
  images              Json // Array of strings: ["/img1.jpg", "/img2.jpg"]
  featured            Boolean         @default(false)
  // Where this product sits among the featured products. Independent of
  // categoryOrder — a product can lead the featured rail and sit eighth in
  // its category. Lower first; ties fall back to newest.
  featuredOrder       Int             @default(0)
  isNew               Boolean         @default(false)
  // Where this product sits within its category listing. Lower first.
  categoryOrder       Int             @default(0)
  // Derived, not typed by hand: recordStockChange rewrites this to
  // (stockQty > 0) on every movement, so it cannot be used to hold an
  // admin's intent — a restock would quietly undo it. See soldOut.
  inStock             Boolean         @default(true)
  // The admin's manual override. Set by a person, never by the stock
  // pipeline, and it wins over any quantity on hand: stock can exist while
  // the product is deliberately not for sale.
  soldOut             Boolean         @default(false)
  stockQty            Int             @default(10)
  // What the unit cost us. Optional — only set for products the owner has
  // entered a buy price for; drives the inventory valuation totals.
  costPriceCents      Int?
  // Per-product override of the store-wide low-stock threshold held in
  // SiteSetting("inventory_low_stock_threshold").
  lowStockThreshold   Int?
  // Plays inline in the gallery as a slide next to the photos.
  videoUrl            String?         @db.VarChar(500)
  // Separate clip for the auto-opening floating corner widget — distinct
  // content from videoUrl, not just an alternate source for the same one.
  popupVideoUrl       String?         @db.VarChar(500)
  archivedAt          DateTime?
  orderItems          OrderItem[]
  stockMovements      StockMovement[]
  productMedia        ProductMedia[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([categoryId])
  // The listing queries sort on these, so let MySQL do it from the index
  // rather than filesorting every product on each page view.
  @@index([categoryId, categoryOrder])
  @@index([featured, featuredOrder])
}

model Order {
  id                  String        @id @default(cuid())
  tranId              String        @unique
  valId               String?
  bankTranId          String?
  cardType            String?
  status              String        @default("PENDING") // PENDING, CALLED, CONFIRMED, CANCELLED, PACKED, SHIPPED, DELIVERED — no payment gateway; CALLED means someone rang the customer, CONFIRMED means they said yes
  totalAmountCents    Int
  currency            String        @default("BDT")
  customerName        String
  customerEmail       String
  customerPhone       String
  customerAddress     String        @db.Text
  customerCity        String
  trackingNumber      String?
  adminNotes          String?       @db.Text
  // Who rang the customer, and when. Set once the order reaches CALLED and
  // kept afterwards, so a confirmed or cancelled order still shows who made
  // the call that decided it. Denormalised name so the record survives the
  // staff account being renamed or deleted.
  calledAt            DateTime?
  calledById          String?
  calledByName        String?
  couponId            String?
  coupon              Coupon?       @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponCode          String?
  discountAmountCents Int           @default(0)
  items               OrderItem[]
  events              OrderEvent[]
  couponUsages        CouponUsage[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([couponId])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  productSku      String
  productSlug     String
  unitPriceCents  Int
  qty             Int
  totalPriceCents Int
  // Stamped when the product this line sold is deleted from the catalogue.
  // productId is nulled by the foreign key at that moment, so without this
  // the order could no longer say what happened to the item it sold. Held on
  // the line rather than looked up by SKU, because a later product may take
  // the freed SKU and would otherwise inherit this history.
  productDeletedAt   DateTime?
  productDeletedBy   String?
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?  @db.Text
  // Which admin caused it. Null for events the checkout itself wrote.
  actorName String?
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Append-only audit trail for every stock change, whether an admin typed it
// or an order caused it. Product.stockQty stays the live number; this is the
// record of how it got there, so a drifting count can be traced.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Signed change. resultQty is the stock level *after* it, stored rather
  // than recomputed so history stays readable even after later edits.
  delta     Int
  resultQty Int
  reason    String // RESTOCK, SALE, RETURN, DAMAGE, LOST, CORRECTION
  note      String?  @db.Text
  // Set when an order drove the change, so a movement links back to it.
  orderId   String?
  actorName String? // admin who made the change, or "System" for order-driven
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}

model Coupon {
  id                      String        @id @default(cuid())
  code                    String        @unique
  discountType            String // "PERCENTAGE" | "FIXED"
  discountValue           Int // percentage (e.g. 20) or fixed cents (e.g. 50000 = ৳500)
  minimumOrderAmountCents Int? // in cents, null for no minimum
  usageLimit              Int? // null = unlimited
  usageCount              Int           @default(0)
  note                    String?       @db.Text
  isActive                Boolean       @default(true)
  orders                  Order[]
  usages                  CouponUsage[]
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([code])
  @@index([isActive])
  @@index([createdAt])
}

model CouponUsage {
  id                    String    @id @default(cuid())
  couponId              String
  coupon                Coupon    @relation(fields: [couponId], references: [id], onDelete: Cascade)
  couponCode            String // denormalized snapshot
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerName          String?
  customerEmail         String?
  customerPhone         String?
  discountAmountCents   Int
  orderSubtotalCents    Int
  finalOrderAmountCents Int
  // Set when the order was cancelled and the redemption handed back. The row
  // is kept rather than deleted so the audit trail stays append-only, but a
  // released row no longer counts towards redemptions or discount totals.
  releasedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([couponId])
  @@index([releasedAt])
  @@index([orderId])
  @@index([customerEmail])
  @@index([customerPhone])
  @@index([createdAt])
}

model Media {
  id           String         @id @default(cuid())
  type         String         // "IMAGE" | "VIDEO"
  url          String         @db.VarChar(1000)
  thumbnailUrl String?        @db.VarChar(1000)
  filename     String
  mimeType     String
  size         Int            // bytes
  // sha256 of the file bytes. Dedup keys off this, not filename/size, so two
  // different files that happen to share a name and byte count never collapse
  // into one Media row.
  contentHash  String         @default("") @db.VarChar(64)
  title        String?
  altText      String?
  productMedia ProductMedia[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([type])
  @@index([createdAt])
  @@index([url])
  @@index([contentHash])
}

model ProductMedia {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId   String
  media     Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, mediaId])
  @@index([productId, sortOrder])
  @@index([mediaId])
}
