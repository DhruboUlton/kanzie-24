generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Category {
  id        String     @id @default(cuid())
  slug      String     @unique
  name      String
  sortOrder Int        @default(0)
  // Self-relation, one level deep: a category with a parent is a
  // subcategory and cannot itself have children (enforced in
  // src/lib/actions/category.ts). Parents act as groupings — products are
  // assigned to leaf categories.
  parentId  String?
  parent    Category?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children  Category[] @relation("CategoryChildren")
  products  Product[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([parentId])
}

model Product {
  id                  String      @id @default(cuid())
  slug                String      @unique
  name                String
  brand               String
  sku                 String      @unique
  categoryId          String
  category            Category    @relation(fields: [categoryId], references: [id])
  priceCents          Int
  compareAtPriceCents Int?
  scale               String
  shortDescription    String      @db.Text
  description         String      @db.Text
  features            Json        // Array of strings: ["feature 1", "feature 2"]
  specs               Json        // Array of objects: [{"label": "Scale", "value": "1:14"}]
  images              Json        // Array of strings: ["/img1.jpg", "/img2.jpg"]
  featured            Boolean     @default(false)
  isNew               Boolean     @default(false)
  inStock             Boolean     @default(true)
  stockQty            Int         @default(10)
  // What the unit cost us. Optional — only set for products the owner has
  // entered a buy price for; drives the inventory valuation totals.
  costPriceCents      Int?
  // Per-product override of the store-wide low-stock threshold held in
  // SiteSetting("inventory_low_stock_threshold").
  lowStockThreshold   Int?
  videoUrl            String?     @db.VarChar(500)
  archivedAt          DateTime?
  orderItems          OrderItem[]
  stockMovements      StockMovement[]
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@index([categoryId])
}

model Order {
  id              String       @id @default(cuid())
  tranId          String       @unique
  valId           String?
  bankTranId      String?
  cardType        String?
  status          String       @default("PENDING") // PENDING, CONFIRMED, CANCELLED, PACKED, SHIPPED, DELIVERED — no payment gateway; CONFIRMED means an admin called and verified the order
  totalAmountCents Int
  currency        String       @default("BDT")
  customerName    String
  customerEmail   String
  customerPhone   String
  customerAddress String       @db.Text
  customerCity    String
  trackingNumber  String?
  adminNotes      String?      @db.Text
  items           OrderItem[]
  events          OrderEvent[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId       String?
  product         Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName     String
  productSku      String
  productSlug     String
  unitPriceCents  Int
  qty             Int
  totalPriceCents Int
  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String?  @db.Text
  createdAt DateTime @default(now())

  @@index([orderId])
}

// Append-only audit trail for every stock change, whether an admin typed it
// or an order caused it. Product.stockQty stays the live number; this is the
// record of how it got there, so a drifting count can be traced.
model StockMovement {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Signed change. resultQty is the stock level *after* it, stored rather
  // than recomputed so history stays readable even after later edits.
  delta     Int
  resultQty Int
  reason    String   // RESTOCK, SALE, RETURN, DAMAGE, LOST, CORRECTION
  note      String?  @db.Text
  // Set when an order drove the change, so a movement links back to it.
  orderId   String?
  actorName String?  // admin who made the change, or "System" for order-driven
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model SiteSetting {
  key       String   @id
  value     String   @db.Text
  updatedAt DateTime @updatedAt
}
