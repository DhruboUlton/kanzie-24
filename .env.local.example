# Copy to .env.local for development, and set the same keys in your host's
# (Hostinger) environment variables for production.

# MySQL Database URL (e.g. mysql://username:password@localhost:3306/database_name)
DATABASE_URL="mysql://root:password@localhost:3306/kanzie_db"

# Admin Authentication Secret (generate random 32+ char string)
ADMIN_SESSION_SECRET="change-this-to-a-secure-random-32-character-secret"

# No payment gateway is wired in yet — /api/checkout creates a PENDING
# order and returns 501 until one is added back (see src/app/api/checkout/
# route.ts). Add that gateway's credentials here when it's chosen.

# BD courier fraud-check merchant logins — your own accounts with each
# courier, used by /admin/fraud-check to look up a customer's delivery
# history before accepting a COD order. Leave any one pair unset and that
# courier's check is reported as "not configured" without failing the
# other two.
PATHAO_USER=
PATHAO_PASSWORD=
REDX_PHONE=
REDX_PASSWORD=
STEADFAST_USER=
STEADFAST_PASSWORD=
